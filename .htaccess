<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Redirigir limpiamente las peticiones hacia /public/
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Denegar acceso directo a archivos confidenciales del proyecto
<FilesMatch "^\.env|composer\.(json|lock)|package\.(json|lock)|phpunit\.xml|artisan|\.git.*|\.editorconfig">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Deshabilitar firmas del servidor y navegación de directorios
ServerSignature Off
Options -Indexes
